-/** The payment due date: the closing date plus `termDays` calendar days. */
-export function paymentDueDate(closing: string, termDays: number): string {
+export type PaymentDueDateOptions = {
+  /** "next-business-day" moves a due date on a Saturday or Sunday to the following Monday. Holidays are not handled. */
+  readonly rollover?: "next-business-day";
+};
+
+// getUTCDay() numbers the week from Sunday (0) to Saturday (6).
+const SUNDAY = 0;
+const SATURDAY = 6;
+
+function nextBusinessDay(date: CalendarDate): CalendarDate {
+  const weekday = new Date(toUtc(date)).getUTCDay();
+  if (weekday === SUNDAY) return addDays(date, 1);
+  if (weekday === SATURDAY) return addDays(date, 2);
+  return date;
+}
+
+/**
+ * The payment due date: the closing date plus `termDays` calendar days. With
+ * `{ rollover: "next-business-day" }`, a due date on a weekend moves to the following Monday.
+ */
+export function paymentDueDate(closing: string, termDays: number, options?: PaymentDueDateOptions): string {
   if (!Number.isInteger(termDays) || termDays < 0) {
     throw new RangeError(`Term must be a non-negative integer number of days, got ${termDays}`);
   }
-  return formatDate(addDays(parseDate(closing), termDays));
+  const due = addDays(parseDate(closing), termDays);
+  return formatDate(options?.rollover === "next-business-day" ? nextBusinessDay(due) : due);
 }
diff --git a/src/rollover.test.ts b/src/rollover.test.ts
new file mode 100644
index 0000000..4abfe2f
--- /dev/null
+++ b/src/rollover.test.ts
@@ -0,0 +1,26 @@
+import { describe, expect, it } from "vitest";
+import { paymentDueDate } from "./dueDate.js";
+
+const NEXT_BUSINESS_DAY = { rollover: "next-business-day" } as const;
+
+describe("paymentDueDate with rollover: next-business-day", () => {
+  it("moves a due date on a Saturday to the following Monday", () => {
+    // 2026-04-30 + 30 days = 2026-05-30, a Saturday; the next Monday is 2026-06-01.
+    expect(paymentDueDate("2026-04-30", 30, NEXT_BUSINESS_DAY)).toBe("2026-06-01");
+  });
+
+  it("moves a due date on a Sunday to the following Monday", () => {
+    // 2026-07-31 + 30 days = 2026-08-30, a Sunday; the next Monday is 2026-08-31.
+    expect(paymentDueDate("2026-07-31", 30, NEXT_BUSINESS_DAY)).toBe("2026-08-31");
+  });
+
+  it("keeps a due date on a weekday", () => {
+    // 2026-05-31 + 30 days = 2026-06-30, a Tuesday.
+    expect(paymentDueDate("2026-05-31", 30, NEXT_BUSINESS_DAY)).toBe("2026-06-30");
+  });
+
+  it("keeps a weekend due date when the option is not given", () => {
+    // Without the third argument nothing moves: 2026-04-30 + 30 days = 2026-05-30, a Saturday.
+    expect(paymentDueDate("2026-04-30", 30)).toBe("2026-05-30");
+  });
+});
