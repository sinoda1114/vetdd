-/** The payment due date: the closing date plus `termDays` calendar days. */
-export function paymentDueDate(closing: string, termDays: number): string {
+export type PaymentDueDateOptions = {
+  /** "next-business-day" moves a due date on a Saturday or Sunday to the following Monday. Holidays are not handled. */
+  readonly rollover?: "next-business-day";
+};
+
+const SUNDAY = 0;
+const SATURDAY = 6;
+
+function nextBusinessDay(date: CalendarDate): CalendarDate {
+  const weekday = new Date(toUtc(date)).getUTCDay();
+  if (weekday === SATURDAY) return addDays(date, 2);
+  if (weekday === SUNDAY) return addDays(date, 1);
+  return date;
+}
+
+/**
+ * The payment due date: the closing date plus `termDays` calendar days, moved to the
+ * following Monday when it falls on a weekend and `options.rollover` is "next-business-day".
+ */
+export function paymentDueDate(
+  closing: string,
+  termDays: number,
+  options: PaymentDueDateOptions = {},
+): string {
   if (!Number.isInteger(termDays) || termDays < 0) {
     throw new RangeError(`Term must be a non-negative integer number of days, got ${termDays}`);
   }
-  return formatDate(addDays(parseDate(closing), termDays));
+  const due = addDays(parseDate(closing), termDays);
+  return formatDate(options.rollover === "next-business-day" ? nextBusinessDay(due) : due);
 }
