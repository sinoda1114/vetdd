-/** The payment due date: the closing date plus `termDays` calendar days. */
-export function paymentDueDate(closing: string, termDays: number): string {
+export type PaymentDueDateOptions = { readonly rollover: "next-business-day" };
+
+const SUNDAY = 0;
+const SATURDAY = 6;
+
+/** Days to move a date forward so that it lands on a weekday (Saturday and Sunday go to Monday). */
+function daysToNextWeekday(date: CalendarDate): number {
+  const weekday = new Date(toUtc(date)).getUTCDay();
+  if (weekday === SATURDAY) return 2;
+  if (weekday === SUNDAY) return 1;
+  return 0;
+}
+
+/**
+ * The payment due date: the closing date plus `termDays` calendar days. With
+ * `{ rollover: "next-business-day" }`, a due date on a Saturday or Sunday moves to the
+ * following Monday. Holidays are not handled.
+ */
+export function paymentDueDate(
+  closing: string,
+  termDays: number,
+  options?: PaymentDueDateOptions,
+): string {
   if (!Number.isInteger(termDays) || termDays < 0) {
     throw new RangeError(`Term must be a non-negative integer number of days, got ${termDays}`);
   }
-  return formatDate(addDays(parseDate(closing), termDays));
+  const due = addDays(parseDate(closing), termDays);
+  if (options?.rollover !== "next-business-day") return formatDate(due);
+  return formatDate(addDays(due, daysToNextWeekday(due)));
 }
