  "oracle_versions": [
    {
      "version": "1",
      "change": "initial",
      "reason": "Initial agreement from the request (decided by the requester, no AskUserQuestion run): paymentDueDate(closing, termDays, { rollover: \"next-business-day\" }) moves a Saturday or Sunday result to the following Monday and keeps a weekday; holidays out of scope; without the option it behaves as today. Expected values from the requester's hand-worked 2026 calendar, cross-checked with macOS date: 2026-04-30 +30 -> 2026-06-01, 2026-07-31 +30 -> 2026-08-31, 2026-05-31 +30 -> 2026-06-30, and without the option 2026-04-30 +30 stays 2026-05-30. Seam: paymentDueDate in src/dueDate.ts. Must stay green: npx vitest run and npm run typecheck. Budget: no subagents, 3 attempts per step, nothing leaves the machine.",
      "agreement": null,
      "after_seq": 0,
      "recorded_at": "2026-10-17T10:25:41Z"
    }
