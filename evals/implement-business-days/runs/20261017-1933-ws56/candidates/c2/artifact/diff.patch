--- a/src/dueDate.ts
+++ b/src/dueDate.ts
@@ -83,10 +83,31 @@ export function closingDate(invoiceDate: string, closingDay: ClosingDay): string
   });
 }
 
-/** The payment due date: the closing date plus `termDays` calendar days. */
-export function paymentDueDate(closing: string, termDays: number): string {
+export type PaymentDueOptions = { readonly rollover: "next-business-day" };
+
+const SUNDAY = 0;
+const SATURDAY = 6;
+
+/** Saturday and Sunday move to the following Monday; holidays are not handled. */
+function nextBusinessDay(date: CalendarDate): CalendarDate {
+  const weekday = new Date(toUtc(date)).getUTCDay();
+  if (weekday === SATURDAY) return addDays(date, 2);
+  if (weekday === SUNDAY) return addDays(date, 1);
+  return date;
+}
+
+/**
+ * The payment due date: the closing date plus `termDays` calendar days. With
+ * `{ rollover: "next-business-day" }`, a due date on a weekend moves to the following Monday.
+ */
+export function paymentDueDate(
+  closing: string,
+  termDays: number,
+  options?: PaymentDueOptions,
+): string {
   if (!Number.isInteger(termDays) || termDays < 0) {
     throw new RangeError(`Term must be a non-negative integer number of days, got ${termDays}`);
   }
-  return formatDate(addDays(parseDate(closing), termDays));
+  const due = addDays(parseDate(closing), termDays);
+  return formatDate(options?.rollover === "next-business-day" ? nextBusinessDay(due) : due);
 }
diff --git a/src/rollover-default.test.ts b/src/rollover-default.test.ts
new file mode 100644
index 0000000..cae15c2
--- /dev/null
+++ b/src/rollover-default.test.ts
@@ -0,0 +1,12 @@
+import { expect, it } from "vitest";
+import { paymentDueDate } from "./dueDate.js";
+
+it("keeps a weekend due date when no rollover is asked for", () => {
+  // 2026-04-30 + 30 days = 2026-05-30, a Saturday; without the option it is not moved.
+  expect(paymentDueDate("2026-04-30", 30)).toBe("2026-05-30");
+});
+
+it("moves the same weekend due date when the rollover is asked for", () => {
+  // Same dates with the option: 2026-05-30 is a Saturday, so it moves to Monday 2026-06-01.
+  expect(paymentDueDate("2026-04-30", 30, { rollover: "next-business-day" })).toBe("2026-06-01");
+});
diff --git a/src/rollover-saturday.test.ts b/src/rollover-saturday.test.ts
new file mode 100644
index 0000000..8cd22de
--- /dev/null
+++ b/src/rollover-saturday.test.ts
@@ -0,0 +1,12 @@
+import { expect, it } from "vitest";
+import { paymentDueDate } from "./dueDate.js";
+
+it("moves a due date that lands on a Saturday to the following Monday", () => {
+  // 2026-04-30 + 30 days = 2026-05-30, a Saturday; the next Monday is 2026-06-01.
+  expect(paymentDueDate("2026-04-30", 30, { rollover: "next-business-day" })).toBe("2026-06-01");
+});
+
+it("does not treat a weekday as a Saturday", () => {
+  // 2026-05-31 + 30 days = 2026-06-30, a Tuesday, so it stays.
+  expect(paymentDueDate("2026-05-31", 30, { rollover: "next-business-day" })).toBe("2026-06-30");
+});
