@@ -84,9 +84,24 @@ export function closingDate(invoiceDate: string, closingDay: ClosingDay): string
 }
 
 /** The payment due date: the closing date plus `termDays` calendar days. */
-export function paymentDueDate(closing: string, termDays: number): string {
+const HOLIDAYS = new Set(["2026-01-01", "2026-05-05", "2026-12-25"]);
+
+export type Rollover = "next-business-day" | "previous-business-day";
+
+export function paymentDueDate(closing: string, termDays: number, options?: { rollover?: Rollover }): string {
   if (!Number.isInteger(termDays) || termDays < 0) {
     throw new RangeError(`Term must be a non-negative integer number of days, got ${termDays}`);
   }
-  return formatDate(addDays(parseDate(closing), termDays));
+  const rollover = options?.rollover;
+  if (rollover !== undefined && rollover !== "next-business-day" && rollover !== "previous-business-day") {
+    throw new RangeError(`Unknown rollover: ${String(rollover)}`);
+  }
+  let due = addDays(parseDate(closing), termDays);
+  const step = rollover === "previous-business-day" ? -1 : 1;
+  while (rollover !== undefined) {
+    const weekday = new Date(toUtc(due)).getUTCDay();
+    if (weekday !== 0 && weekday !== 6 && !HOLIDAYS.has(formatDate(due))) break;
+    due = addDays(due, step);
+  }
+  return formatDate(due);
 }
