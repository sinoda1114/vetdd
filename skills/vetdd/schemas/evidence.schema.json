{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vetdd slice evidence",
  "description": ".vetdd/evidence/<slice-id>/meta.json, written by scripts/evidence.sh and checked by scripts/check-evidence.sh (plan §2.4).",
  "type": "object",
  "additionalProperties": false,
  "required": ["slice_id", "oracle", "runs"],
  "properties": {
    "slice_id": { "$ref": "#/$defs/sliceId" },
    "oracle": {
      "description": "The oracle of the latest accepted run; check-evidence rule 6 rehashes its files.",
      "$ref": "#/$defs/oracle"
    },
    "runs": { "type": "array", "items": { "$ref": "#/$defs/run" } },
    "oracle_versions": {
      "description": "Why each oracle version changed, written by scripts/oracle-version.sh; absent in evidence recorded before the log existed. Once the key exists, check-evidence rule 8d asks for an entry for the version the final green rests on, unless it is the initial agreement (an older version left behind is history).",
      "type": "array",
      "items": { "$ref": "#/$defs/oracleVersion" }
    },
    "audits": {
      "description": "Why an audit does not apply to this slice, written by scripts/audit-note.sh; absent when none was recorded. Once the key exists with an undefined-imports entry or empty (or a run carries an undefined-imports audit mark), check-evidence rule 10b asks for an undefined-imports audit of the final oracle: an accepted audit run, or an entry here. A mutation entry is the rule 10c alternative to a mutation run, for a language with no mutation tool; a mutation run or entry is what makes rule 10c ask.",
      "type": "array",
      "items": { "$ref": "#/$defs/auditNote" }
    }
  },
  "$defs": {
    "sliceId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "gitObjectId": { "type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$" },
    "mutationReport": {
      "description": "A StrykerJS JSON report read after the run. Never changes the outcome.",
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "path", "status", "sha256", "copy", "counts", "files"],
          "properties": {
            "format": { "const": "stryker-json" },
            "path": { "type": "string", "minLength": 1 },
            "status": { "const": "ok" },
            "sha256": { "description": "Of the normalized copy at `copy`: config.mutate, and each file's source and mutants (id, mutatorName, replacement, status, location).", "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "copy": { "type": "string", "pattern": "^runs/[0-9]{3,}-mutation\\.json$" },
            "counts": {
              "description": "Mutants by final status: Killed, Survived, NoCoverage, Timeout, CompileError, RuntimeError, Ignored.",
              "type": "object",
              "additionalProperties": false,
              "required": ["killed", "survived", "no_coverage", "timeout", "compile_error", "runtime_error", "ignored", "total"],
              "properties": {
                "killed": { "type": "integer", "minimum": 0 }, "survived": { "type": "integer", "minimum": 0 }, "no_coverage": { "type": "integer", "minimum": 0 }, "timeout": { "type": "integer", "minimum": 0 },
                "compile_error": { "type": "integer", "minimum": 0 }, "runtime_error": { "type": "integer", "minimum": 0 }, "ignored": { "type": "integer", "minimum": 0 }, "total": { "type": "integer", "minimum": 0 }
              }
            },
            "files": {
              "description": "Every file the report mutated, as a repository path, with the sha256 of the source the report holds for it.",
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "sha256"],
                "properties": {
                  "path": { "type": "string", "minLength": 1 },
                  "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "path", "status"],
          "properties": {
            "format": { "const": "stryker-json" },
            "path": { "type": "string", "minLength": 1 },
            "status": { "description": "missing: no report after the run; invalid: not a usable stryker-json report.", "enum": ["missing", "invalid"] }
          }
        }
      ]
    },
    "auditNote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "status", "reason", "recorded_at"],
      "properties": {
        "kind": { "enum": ["undefined-imports", "mutation"] },
        "status": { "description": "not_applicable: the audit cannot apply to this slice (nothing to stub, or no mutation tool for its language; the reason says why).", "enum": ["not_applicable"] },
        "reason": { "type": "string", "minLength": 1 },
        "recorded_at": { "$ref": "#/$defs/timestamp" },
        "after_seq": { "description": "The largest runs[].seq when the note was written (0 with no run). The note counts for an oracle whose first run has a seq no larger than this; a note without it (written before it existed) is judged by recorded_at.", "type": "integer", "minimum": 0 }
      }
    },
    "oracleVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "change", "reason", "agreement", "after_seq", "recorded_at"],
      "properties": {
        "version": { "$ref": "#/$defs/sliceId" },
        "change": { "description": "initial: the first agreement; implementation: the test changed, the agreed behavior did not; meaning: the agreed behavior changed (needs an agreement).", "enum": ["initial", "implementation", "meaning"] },
        "reason": { "type": "string", "minLength": 1 },
        "agreement": {
          "description": "The re-agreement (principle 1a); required when change is meaning.",
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["via", "question", "answer"],
              "properties": {
                "via": { "enum": ["AskUserQuestion", "chat"] },
                "question": { "type": "string", "minLength": 1 },
                "answer": { "type": "string", "minLength": 1 }
              }
            },
            { "type": "null" }
          ]
        },
        "after_seq": { "description": "The highest run seq recorded when the entry was written (0 when none); the version's first red must come after it.", "type": "integer", "minimum": 0 },
        "recorded_at": { "$ref": "#/$defs/timestamp" }
      },
      "if": { "properties": { "change": { "const": "meaning" } }, "required": ["change"] },
      "then": { "properties": { "agreement": { "type": "object" } } }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seam", "version", "files"],
      "properties": {
        "seam": { "type": ["string", "null"] },
        "version": { "type": ["string", "null"] },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": { "description": "Relative to the repository root.", "type": "string", "minLength": 1 },
              "sha256": {
                "description": "null when the file was missing at record time.",
                "anyOf": [{ "type": "string", "pattern": "^[0-9a-f]{64}$" }, { "type": "null" }]
              }
            }
          }
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seq", "kind", "cmd", "exit_code", "outcome", "accepted", "started_at", "ended_at", "log", "tree", "conditions", "oracle"],
      "properties": {
        "seq": { "type": "integer", "minimum": 1 },
        "kind": { "enum": ["calibration", "before", "after", "integrated"] },
        "cmd": { "description": "argv of the oracle command.", "type": "array", "minItems": 1, "items": { "type": "string" } },
        "exit_code": { "type": "integer", "minimum": 0, "maximum": 255 },
        "outcome": { "enum": ["pass", "target_failure", "infrastructure_error", "inconclusive"] },
        "accepted": {
          "description": "false when the outcome violates the kind (before must be target_failure, after/integrated must be pass). Rejected runs stay as history.",
          "type": "boolean"
        },
        "started_at": { "$ref": "#/$defs/timestamp" },
        "ended_at": { "$ref": "#/$defs/timestamp" },
        "log": { "description": "stdout+stderr, relative to the slice directory.", "type": "string", "pattern": "^runs/[0-9]{3,}-(calibration|before|after|integrated)\\.log$" },
        "tree": {
          "type": "object",
          "additionalProperties": false,
          "required": ["head_sha", "tree_hash"],
          "properties": {
            "head_sha": { "description": "null before the first commit.", "anyOf": [{ "$ref": "#/$defs/gitObjectId" }, { "type": "null" }] },
            "tree_hash": { "description": "Working tree incl. uncommitted changes, excluding .gitignored paths and .vetdd/.", "$ref": "#/$defs/gitObjectId" }
          }
        },
        "conditions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cwd", "node_version", "env_keys"],
          "properties": {
            "cwd": { "description": "Relative to the repository root; \".\" for the root.", "type": "string", "minLength": 1 },
            "node_version": { "type": ["string", "null"] },
            "env_keys": { "description": "Sorted names (never values) of VETDD_* environment variables.", "type": "array", "items": { "type": "string", "pattern": "^VETDD_" } }
          }
        },
        "oracle": { "description": "The oracle this run was measured with.", "$ref": "#/$defs/oracle" },
        "audit": {
          "description": "An audit run (a calibration that is never counted as a red). undefined-imports: set by calibrate.sh stub; every product file the oracle imports was replaced by a stub whose exports are all undefined, so it must end target_failure (check-evidence rule 10a). mutation: evidence.sh --audit mutation --mutation-report; a mutation testing run whose report is summarized here.",
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind"],
              "properties": { "kind": { "const": "undefined-imports" } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "report"],
              "properties": {
                "kind": { "const": "mutation" },
                "report": { "$ref": "#/$defs/mutationReport" }
              }
            }
          ]
        },
        "tests": {
          "description": "Counts from the runner's report (evidence.sh --test-report). Never changes the outcome. Absent when no report was asked for.",
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["format", "status", "passed", "failed", "skipped", "todo", "other", "total", "sha256"],
              "properties": {
                "format": { "enum": ["jest-json"] },
                "status": { "enum": ["ok"] },
                "passed": { "type": "integer", "minimum": 0 },
                "failed": { "type": "integer", "minimum": 0 },
                "skipped": { "description": "skipped, pending, and disabled tests.", "type": "integer", "minimum": 0 },
                "todo": { "type": "integer", "minimum": 0 },
                "other": { "description": "Tests with any other status; never dropped.", "type": "integer", "minimum": 0 },
                "total": { "type": "integer", "minimum": 0 },
                "sha256": { "description": "Of the normalized copy runs/<seq>-<kind>.tests.json.", "type": "string", "pattern": "^[0-9a-f]{64}$" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["format", "status"],
              "properties": {
                "format": { "enum": ["jest-json"] },
                "status": { "description": "missing: no report after the run; invalid: not a jest-json report.", "enum": ["missing", "invalid"] }
              }
            }
          ]
        }
      }
    }
  }
}
