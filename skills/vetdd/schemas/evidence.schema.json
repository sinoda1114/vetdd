{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vetdd slice evidence",
  "description": ".vetdd/evidence/<slice-id>/meta.json, written by scripts/evidence.sh and checked by scripts/check-evidence.sh (plan §2.4).",
  "type": "object",
  "additionalProperties": false,
  "required": ["slice_id", "oracle", "runs"],
  "properties": {
    "slice_id": { "$ref": "#/$defs/sliceId" },
    "oracle": {
      "description": "The oracle of the latest accepted run; check-evidence rule 6 rehashes its files.",
      "$ref": "#/$defs/oracle"
    },
    "runs": { "type": "array", "items": { "$ref": "#/$defs/run" } },
    "oracle_versions": {
      "description": "Why each oracle version changed, written by scripts/oracle-version.sh; absent in evidence recorded before the log existed. Check-evidence rule 8d asks for an entry for every version after the first once the key exists.",
      "type": "array",
      "items": { "$ref": "#/$defs/oracleVersion" }
    }
  },
  "$defs": {
    "sliceId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "gitObjectId": { "type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$" },
    "oracleVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "change", "reason", "agreement", "after_seq", "recorded_at"],
      "properties": {
        "version": { "$ref": "#/$defs/sliceId" },
        "change": { "description": "initial: the first agreement; implementation: the test changed, the agreed behavior did not; meaning: the agreed behavior changed (needs an agreement).", "enum": ["initial", "implementation", "meaning"] },
        "reason": { "type": "string", "minLength": 1 },
        "agreement": {
          "description": "The re-agreement (principle 1a); required when change is meaning.",
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["via", "question", "answer"],
              "properties": {
                "via": { "enum": ["AskUserQuestion", "chat"] },
                "question": { "type": "string", "minLength": 1 },
                "answer": { "type": "string", "minLength": 1 }
              }
            },
            { "type": "null" }
          ]
        },
        "after_seq": { "description": "The highest run seq recorded when the entry was written (0 when none); the version's first red must come after it.", "type": "integer", "minimum": 0 },
        "recorded_at": { "$ref": "#/$defs/timestamp" }
      },
      "if": { "properties": { "change": { "const": "meaning" } }, "required": ["change"] },
      "then": { "properties": { "agreement": { "type": "object" } } }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seam", "version", "files"],
      "properties": {
        "seam": { "type": ["string", "null"] },
        "version": { "type": ["string", "null"] },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": { "description": "Relative to the repository root.", "type": "string", "minLength": 1 },
              "sha256": {
                "description": "null when the file was missing at record time.",
                "anyOf": [{ "type": "string", "pattern": "^[0-9a-f]{64}$" }, { "type": "null" }]
              }
            }
          }
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seq", "kind", "cmd", "exit_code", "outcome", "accepted", "started_at", "ended_at", "log", "tree", "conditions", "oracle"],
      "properties": {
        "seq": { "type": "integer", "minimum": 1 },
        "kind": { "enum": ["calibration", "before", "after", "integrated"] },
        "cmd": { "description": "argv of the oracle command.", "type": "array", "minItems": 1, "items": { "type": "string" } },
        "exit_code": { "type": "integer", "minimum": 0, "maximum": 255 },
        "outcome": { "enum": ["pass", "target_failure", "infrastructure_error", "inconclusive"] },
        "accepted": {
          "description": "false when the outcome violates the kind (before must be target_failure, after/integrated must be pass). Rejected runs stay as history.",
          "type": "boolean"
        },
        "started_at": { "$ref": "#/$defs/timestamp" },
        "ended_at": { "$ref": "#/$defs/timestamp" },
        "log": { "description": "stdout+stderr, relative to the slice directory.", "type": "string", "pattern": "^runs/[0-9]{3,}-(calibration|before|after|integrated)\\.log$" },
        "tree": {
          "type": "object",
          "additionalProperties": false,
          "required": ["head_sha", "tree_hash"],
          "properties": {
            "head_sha": { "description": "null before the first commit.", "anyOf": [{ "$ref": "#/$defs/gitObjectId" }, { "type": "null" }] },
            "tree_hash": { "description": "Working tree incl. uncommitted changes, excluding .gitignored paths and .vetdd/.", "$ref": "#/$defs/gitObjectId" }
          }
        },
        "conditions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cwd", "node_version", "env_keys"],
          "properties": {
            "cwd": { "description": "Relative to the repository root; \".\" for the root.", "type": "string", "minLength": 1 },
            "node_version": { "type": ["string", "null"] },
            "env_keys": { "description": "Sorted names (never values) of VETDD_* environment variables.", "type": "array", "items": { "type": "string", "pattern": "^VETDD_" } }
          }
        },
        "oracle": { "description": "The oracle this run was measured with.", "$ref": "#/$defs/oracle" },
        "tests": {
          "description": "Counts from the runner's report (evidence.sh --test-report). Never changes the outcome. Absent when no report was asked for.",
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["format", "status", "passed", "failed", "skipped", "todo", "other", "total", "sha256"],
              "properties": {
                "format": { "enum": ["jest-json"] },
                "status": { "enum": ["ok"] },
                "passed": { "type": "integer", "minimum": 0 },
                "failed": { "type": "integer", "minimum": 0 },
                "skipped": { "description": "skipped, pending, and disabled tests.", "type": "integer", "minimum": 0 },
                "todo": { "type": "integer", "minimum": 0 },
                "other": { "description": "Tests with any other status; never dropped.", "type": "integer", "minimum": 0 },
                "total": { "type": "integer", "minimum": 0 },
                "sha256": { "description": "Of the normalized copy runs/<seq>-<kind>.tests.json.", "type": "string", "pattern": "^[0-9a-f]{64}$" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["format", "status"],
              "properties": {
                "format": { "enum": ["jest-json"] },
                "status": { "description": "missing: no report after the run; invalid: not a jest-json report.", "enum": ["missing", "invalid"] }
              }
            }
          ]
        }
      }
    }
  }
}
